{
  "collectionName": "components_order_items",
  "info": {
    "name": "item",
    "icon": "shopping-cart"
  },
  "options": {},
  "attributes": {
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product"
    },
    "productId": {
      "type": "integer"
    },
    "slug": {
      "type": "string"
    },
    "productName": {
      "type": "string",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "required": true
    },
    "unitPrice": {
      "type": "decimal",
      "required": true
    },
    "imageUrl": {
      "type": "string"
    },
    "ean": {
      "type": "string"
    },
    "event": {
      "type": "json"
    },

    "type": {
      "type": "enumeration",
      "enum": ["product", "gift_voucher", "event", "service"],
      "default": "product"
    },
    "isGiftVoucher": {
      "type": "boolean",
      "default": false
    },
    "voucherType": {
      "type": "enumeration",
      "enum": ["service", "value"]
    },
    "voucherValue": {
      "type": "decimal",
      "precision": 12,
      "scale": 2
    },
    "voucherValidTo": {
      "type": "datetime"
    },
    "recipientName": {
      "type": "string"
    },
    "recipientEmail": {
      "type": "email"
    },
    "giftMessage": {
      "type": "text"
    }
  }
}