{
  "kind": "collectionType",
  "collectionName": "products",
  "info": { "singularName": "product", "pluralName": "products", "displayName": "Produkty" },
  "options": { "draftAndPublish": false },
  "pluginOptions": {
    "content-manager": { "mainField": "name" },
    "i18n": { "localized": true }
  },
  "attributes": {
    "externalId": { "type": "integer", "required": false, "unique": false },

    "type": {
      "type": "enumeration",
      "enum": ["simple", "variable", "variation"],
      "default": "simple"
    },

    "ean": { "type": "string" },

    "name": {
      "type": "string",
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true,
      "unique": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "short": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "describe": {
      "type": "richtext",
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "public": { "type": "boolean", "default": false },
    "price": { "type": "decimal" },
    "price_sale": { "type": "decimal", "description": "Zľavnená cena" },
    "vatPercentage": { "type": "integer", "default": 23, "required": true },
    "inSale": { "type": "boolean", "default": false },
    "isNew": { "type": "boolean", "default": false },
    "isSoldOut": { "type": "boolean", "default": false },
    "isUnavailable": { "type": "boolean", "default": false },
    "isFeatured": { "type": "boolean", "default": false },

    "category": { "type": "string" },
    "tag": { "type": "string" },

    "picture": { "type": "string" },
    "picture_new": { "type": "media", "multiple": false, "allowedTypes": ["images"] },
    "pictures_new": { "type": "media", "multiple": true, "allowedTypes": ["images"] },

    "variable": { "type": "string" },

    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "inversedBy": "variations"
    },

    "variations": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::product.product",
      "mappedBy": "parent"
    },

    "author": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "product"
    },

    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": { "i18n": { "localized": true } }
    },

    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "products"
    },

    "favorites": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::favorite.favorite",
      "mappedBy": "product"
    },

    "autor": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::autor.autor",
      "inversedBy": "produkty"
    },

    "tvar": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tvar.tvar",
      "inversedBy": "produkty"
    },

    "dekory": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::dekor.dekor",
      "inversedBy": "produkty"
    },

    "vyska_cm": { "type": "decimal", "description": "Výška v cm" },
    "sirka_cm": { "type": "decimal", "description": "Šírka v cm" },
    "hlbka_cm": { "type": "decimal", "description": "Hĺbka v cm" },
    "objem_ml": { "type": "integer", "description": "Objem v ml" },
    "vaha_g": { "type": "integer", "description": "Hmotnosť v g" },

    "productEventType": {
      "type": "enumeration",
      "enum": ["none", "workshop", "tour"],
      "default": "none",
      "configurable": true
    },

    "event_sessions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-session.event-session",
      "mappedBy": "product",
      "description": "Termíny workshopov / prehliadok"
    },

    "event_series": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::event-series.event-series",
      "mappedBy": "product"
    }
  }
}
