{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Objednávky"
  },
  "options": { "draftAndPublish": false, "timestamps": true },
  "attributes": {
    "invoiceNumber": { "type": "string", "unique": true },
    "krosInvoiceNumber": {
      "type": "string"
    },
    "krosInvoiceIssuedAt": {
      "type": "datetime"
    },
    "publicToken": { "type": "string", "unique": true },
    "invoiceIssuedAt": { "type": "datetime" },
    "customerName": { "type": "string", "required": true },
    "orderLocale": {
      "type": "enumeration",
      "enum": ["sk", "en", "de"],
      "default": "sk"
    },
    "customerEmail": { "type": "email", "required": true },
    "customerPhone": {
      "type": "string"
    },
    "shippingAddress": { "type": "json", "required": true },

    "billingIsCompany": { "type": "boolean", "default": false },
    "billingCompanyName": { "type": "string" },
    "billingIco": { "type": "string" },
    "billingDic": { "type": "string" },
    "billingIcDph": { "type": "string" },
    "billingAddress": {
      "type": "component",
      "repeatable": false,
      "component": "shared.address"
    },

    "deliveryUrgency": {
      "type": "enumeration",
      "enum": ["standard", "rush"],
      "default": "standard"
    },
    "notes": { "type": "text" },

    "total": { "type": "decimal", "required": true },
    "shippingFee": { "type": "decimal", "default": 0 },
    "totalWithShipping": { "type": "decimal", "default": 0 },

    "giftVoucherCode": { "type": "string" },
    "giftVoucherDiscount": {
      "type": "decimal",
      "precision": 12,
      "scale": 2,
      "default": 0
    },
    "giftVoucherStatus": {
      "type": "enumeration",
      "enum": ["reserved", "applied", "released"],
      "default": "released"
    },

    "orderStatus": {
      "type": "enumeration",
      "enum": ["pending","confirmed","cancelled"],
      "default": "pending",
      "required": true
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.item"
    },

    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer",
      "inversedBy": "orders",
      "required": true
    },

    

    "paymentMethod": {
      "type": "enumeration",
      "enum": ["card", "cod", "bank", "onsite", "post"],
      "required": true,
      "default": "card"
    },
    "paymentSessionId": { "type": "string" },
    "comgateTransId": { "type": "string" },
    "paymentStatus": {
      "type": "enumeration",
      "enum": ["unpaid", "paid", "refunded"],
      "default": "unpaid",
      "required": true
    },

    "paymentFee": { "type": "decimal", "default": 0 },

    "is_digital_product": {
      "type": "boolean",
      "default": false
    },

    "fulfillmentStatus": {
      "type": "enumeration",
      "enum": ["new","processing","shipped","delivered","cancelled"],
      "default": "new",
      "required": true
    },
    "deliveryStatus": {
      "type": "enumeration",
      "enum": ["label_created","in_transit","at_pickup","delivered","returned"],
      "default": "label_created",
      "required": true
    },

    "deliveryMethod": {
      "type": "enumeration",
      "enum": ["pickup", "post_office", "packeta_box", "post_courier", "digital_product"],
      "required": true,
      "default": "pickup"
    },
    "deliveryAddress": {
      "type": "component",
      "repeatable": false,
      "component": "shared.address"
    },
    "deliveryDetails": {
      "type": "component",
      "repeatable": false,
      "component": "checkout.delivery-details"
    },

    "parcelWeightKg": { "type": "decimal", "precision": 6, "scale": 2 },
    "packetaShipmentId": { "type": "string" },
    "packetaTrackingNumber": { "type": "string" },
    "packetaLabelUrl": { "type": "text" },
    "packetaStatus": {
      "type": "enumeration",
      "enum": ["created","label_downloaded","shipped","delivered","cancelled"]
    },

    "temporaryId": { "type": "string" },

    "giftWrap": { "type": "json" },
    "giftWrapMode": { "type": "string" },
    "giftWrapNote": { "type": "text" },
    "giftWrapSelectedQty": { "type": "integer" },

    "krosRequestId": { "type": "string" },
    "krosStatus": { "type": "string" },
    "krosDocumentId": { "type": "string" },
    "invoiceUrl": { "type": "text" },
    "sentToKrosAt": { "type": "datetime" },
    "krosLastPayload": { "type": "json" },
    "krosLastWebhook": { "type": "json" },

    "confirmationEmailStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "failed"],
      "default": "pending"
    },
    "confirmationEmailSentAt": { "type": "datetime" },
    "confirmationEmailError": { "type": "text" },
    "confirmationEmailMessageId": { "type": "string" },

    "giftVouchersGeneratedAt": { "type": "datetime" },

    "createdGiftVouchers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gift-voucher.gift-voucher",
      "mappedBy": "sourceOrder"
    },
    "redeemedGiftVouchers": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::gift-voucher.gift-voucher",
      "mappedBy": "usedByOrder"
    }
  }
}