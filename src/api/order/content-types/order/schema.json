{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Objednávky"
  },
  "options": { "draftAndPublish": false, "timestamps": true },
  "attributes": {
    "customerName": { "type": "string", "required": true },
    "customerEmail": { "type": "email", "required": true },
    "shippingAddress": { "type": "json", "required": true },

    "total": { "type": "decimal", "required": true },
    "shippingFee": { "type": "decimal", "default": 0 },
    "totalWithShipping": { "type": "decimal", "default": 0 },

    "orderStatus": {
      "type": "enumeration",
      "enum": ["pending","confirmed","cancelled"],
      "default": "pending",
      "required": true
    },
    "items": {
      "type": "component",
      "repeatable": true,
      "component": "order.item"
    },

    "customer": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::customer.customer",
      "inversedBy": "orders",
      "required": true
    },

    "paymentMethod": {
      "type": "enumeration",
      "enum": ["card", "cod", "bank", "onsite", "post"],
      "required": true,
      "default": "card"
    },
    "paymentSessionId": { "type": "string" },
    "comgateTransId": { "type": "string" },
    "paymentStatus": {
      "type": "enumeration",
      "enum": ["unpaid", "paid", "refunded"],
      "default": "unpaid",
      "required": true
    },

    "paymentFee": { "type": "decimal", "default": 0 },


    "fulfillmentStatus": {
      "type": "enumeration",
      "enum": ["new","processing","shipped","delivered","cancelled"],
      "default": "new",
      "required": true
    },
    "deliveryStatus": {
      "type": "enumeration",
      "enum": ["label_created","in_transit","at_pickup","delivered","returned"],
      "default": "label_created",
      "required": true
    },

    "deliveryMethod": {
      "type": "enumeration",
      "enum": ["pickup", "post_office", "packeta_box", "post_courier"],
      "required": true,
      "default": "pickup"
    },
    "deliveryAddress": {
      "type": "component",
      "repeatable": false,
      "component": "shared.address"
    },
    "deliveryDetails": {
      "type": "component",
      "repeatable": false,
      "component": "checkout.delivery-details"
    },

    "parcelWeightKg": { "type": "decimal", "precision": 6, "scale": 2 },
    "packetaShipmentId": { "type": "string" },
    "packetaTrackingNumber": { "type": "string" },
    "packetaLabelUrl": { "type": "text" },
    "packetaStatus": {
      "type": "enumeration",
      "enum": ["created","label_downloaded","shipped","delivered","cancelled"]
    },

    "temporaryId": { "type": "string" }
  }
}
