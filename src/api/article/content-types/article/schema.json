{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Podstránky"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "pluginOptions": { "i18n": { "localized": true } }
    },
    "slug": {
      "type": "string",
      "required": true,
      "unique": false,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "created": {
      "type": "datetime"
    },
    "content": {
      "type": "dynamiczone",
      "components": [
        "blocks.heading-block",
        "blocks.text-block",
        "blocks.image-block",
        "blocks.link-block",
        "blocks.video-block"
      ],
      "pluginOptions": { "i18n": { "localized": true } }
    }
  }
}
